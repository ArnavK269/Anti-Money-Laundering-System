# --platform=linux/amd64 fixes "exec format error" on Windows/Intel Docker.
# Without this, Docker can pull a cached arm64 python image and fail at runtime.
FROM --platform=linux/amd64 python:3.11-slim

WORKDIR /app

COPY IsolationForestService.py .

RUN pip install --no-cache-dir \
    flask \
    flask-cors \
    scikit-learn \
    numpy \
    requests

EXPOSE 5000

CMD ["python", "IsolationForestService.py"]
