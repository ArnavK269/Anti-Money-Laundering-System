# ─────────────────────────────────────────────────────────────────
# AML Platform — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# PostgreSQL (host-side, used by all services)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aml_db
DB_USER=postgres
DB_PASSWORD=

# Spring Boot (Transaction Monitoring Java service)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aml_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# .NET Risk Service (Docker-internal connection string)
# ConnectionStrings__DefaultConnection=Host=host.docker.internal;Port=5432;Database=aml_db;Username=postgres;Password=

# ML Service URLs (set automatically by docker-compose; override for local dev)
# ML_SERVICE_URL=http://localhost:8000       # Risk ML
# ML_SERVICE_URL=http://localhost:5000       # Transaction ML

# Gateway downstream URLs (override for local dev outside Docker)
# AML_SERVICES_RISK_URL=http://localhost:8081
# AML_SERVICES_SCREENING_URL=http://localhost:8082
# AML_SERVICES_TRANSACTIONS_URL=http://localhost:8083

# Frontend (Vite — must be prefixed with VITE_)
# VITE_GATEWAY_URL=http://localhost:8080
# VITE_RISK_URL=http://localhost:8081
# VITE_SCREENING_URL=http://localhost:8082
# VITE_TRANSACTION_URL=http://localhost:8083
